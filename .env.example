# Copy to .env and adjust. Every value has a default, so .env is optional.

# Ports
API_PORT=5008
MONGO_EXPRESS_PORT=8081

# API
LOG_LEVEL=INFO
# JSON list of browser origins allowed to call the API; empty list disables CORS
# e.g. CORS_ORIGINS='["http://localhost:5173"]'
CORS_ORIGINS='[]'
# Accept mock bearer tokens "mock:<user_id>:<role1>,<role2>". Local testing only
AUTH_MOCK_ENABLED=false

# MongoDB (docker-compose overrides MONGODB_URI to reach the base-mongo container)
MONGODB_URI=mongodb://localhost:27017
MONGO_DB=base_api_db
MONGO_VERSION=6

# Mongo Express
MONGO_EXPRESS_VERSION=1.0.0-alpha.4
MONGO_EXPRESS_USER=admin
MONGO_EXPRESS_PASSWORD=admin

# Integrations
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/auto
